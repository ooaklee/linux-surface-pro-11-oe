From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Surface Pro 11 bring-up <noreply@example.invalid>
Date: Sun, 9 Aug 2026 00:00:00 +0100
Subject: [PATCH] debian.qcom-x1e: use controlled SP11 module signing

Give the release candidate a new co-installable ABI and consume the
owner-controlled encrypted signing key from one fixed container path. This
prevents Kbuild from generating a different ephemeral certificate for every
clean build while keeping private material outside the source and build trees.
---
 debian.qcom-x1e/changelog          | 6 ++++++
 debian.qcom-x1e/config/annotations | 4 ++--
 debian/rules.d/2-binary-arch.mk    | 2 +-
 3 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/debian.qcom-x1e/changelog b/debian.qcom-x1e/changelog
--- a/debian.qcom-x1e/changelog
+++ b/debian.qcom-x1e/changelog
@@ -1,3 +1,9 @@
+linux-qcom-x1e (7.2-rc5-jg-0sp11v3r2) resolute; urgency=medium
+
+  * Surface Pro 11 r2: use controlled reproducible module signing.
+
+ -- Surface Pro 11 bring-up <noreply@example.invalid>  Sun, 09 Aug 2026 00:00:00 +0100
+
 linux-qcom-x1e (7.2-rc5-jg-0sp11v3) resolute; urgency=medium
 
   * Surface Pro 11 v3: enable the MSHW0485 QSPI touchscreen.
diff --git a/debian.qcom-x1e/config/annotations b/debian.qcom-x1e/config/annotations
--- a/debian.qcom-x1e/config/annotations
+++ b/debian.qcom-x1e/config/annotations
@@ -6794,6 +6794,6 @@ CONFIG_MODULE_SIG_FORCE                         policy<{'arm64': 'n'}>
 CONFIG_MODULE_SIG_FORMAT                        policy<{'arm64': 'y'}>
 CONFIG_MODULE_SIG_HASH                          policy<{'arm64': '"sha512"'}>
-CONFIG_MODULE_SIG_KEY                           policy<{'arm64': '"certs/signing_key.pem"'}>
+CONFIG_MODULE_SIG_KEY                           policy<{'arm64': '"/sp11-signing/signing.pem"'}>
 CONFIG_MODULE_SIG_KEY_TYPE_ECDSA                policy<{'arm64': 'n'}>
 CONFIG_MODULE_SIG_KEY_TYPE_MLDSA_44             policy<{'arm64': 'n'}>
 CONFIG_MODULE_SIG_KEY_TYPE_MLDSA_65             policy<{'arm64': 'n'}>
@@ -12882,2 +12882,2 @@ CONFIG_VSOCKETS_LOOPBACK                        policy<{'arm64': 'm'}>
-CONFIG_VERSION_SIGNATURE                        policy<{'arm64': '"Ubuntu 7.2-rc5-jg-0sp11v3-qcom-x1e 7.2-rc5"'}>
+CONFIG_VERSION_SIGNATURE                        policy<{'arm64': '"Ubuntu 7.2-rc5-jg-0sp11v3r2-qcom-x1e 7.2-rc5"'}>
 CONFIG_VETH                                     policy<{'arm64': 'm'}>
diff --git a/debian/rules.d/2-binary-arch.mk b/debian/rules.d/2-binary-arch.mk
--- a/debian/rules.d/2-binary-arch.mk
+++ b/debian/rules.d/2-binary-arch.mk
@@ -134,6 +134,6 @@ $(stampdir)/stamp-install-%: hdrdir = $(CURDIR)/debian/$(basepkg)-$*/usr/src/$(b
 $(stampdir)/stamp-install-%: rustdir = $(CURDIR)/debian/$(baserustpkg)-$*/usr/src/$(baserustpkg)-$*
 $(stampdir)/stamp-install-%: MODHASHALGO=sha512
-$(stampdir)/stamp-install-%: MODSECKEY=$(build_dir)/certs/signing_key.pem
+$(stampdir)/stamp-install-%: MODSECKEY=/sp11-signing/signing.pem
 $(stampdir)/stamp-install-%: MODPUBKEY=$(build_dir)/certs/signing_key.x509
 $(stampdir)/stamp-install-%: dkms_dir=$(call dkms_dir_prefix,$(build_dir))
 $(stampdir)/stamp-install-%: STUBBLEDTBS = $(shell /usr/libexec/stubble/finddtbs.py $(build_dir)/arch/arm64/boot/dts /usr/share/stubble/hwids 2>/dev/null | sed 's|.*|--devicetree-auto=&|' | tr '\n' ' ')
-- 
2.50.1
