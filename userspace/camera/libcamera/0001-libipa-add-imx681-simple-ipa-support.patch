Description: Add Sony IMX681 support to the simple IPA
 The SP11 kernel exposes V4L2_CID_ANALOGUE_GAIN as code x in the range
 0..960 and programs global U8.8 gain 0x0100 + 4*x. Describe the resulting
 real-gain relationship, 1 + x/64, to the simple IPA and ship model-named
 tuning data. Leave black level unset until raw dark frames establish it.
Origin: other, https://github.com/ooaklee/linux-surface-pro-11-oe
Forwarded: no
Last-Update: 2026-08-28
---
diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
index e3e3e5355..861edda42 100644
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -645,1 +645,12 @@
+class CameraSensorHelperImx681 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperImx681()
+	{
+		/* The kernel maps code x to U8.8 gain 0x0100 + 4 * x. */
+		gain_ = AnalogueGainLinear{ 1, 64, 0, 64 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("imx681", CameraSensorHelperImx681)
+
 class CameraSensorHelperImx708 : public CameraSensorHelper
diff --git a/src/ipa/simple/data/imx681.yaml b/src/ipa/simple/data/imx681.yaml
new file mode 100644
index 000000000..2f83c2f70
--- /dev/null
+++ b/src/ipa/simple/data/imx681.yaml
@@ -0,0 +1,36 @@
+# SPDX-License-Identifier: CC0-1.0
+# Sony IMX681 front camera in the Microsoft Surface Pro 11.
+#
+# The colour matrices are seed values published by sp11-imx681-linux at
+# b08f76f40b8d7b715bd4da6aef484f86142cc147 and attributed there to Windows
+# CAMX tuning. They still require validation against a colour target on Linux.
+#
+# Black level is deliberately left unspecified. The simple IPA will estimate
+# it from image statistics until a value has been measured from raw dark frames.
+%YAML 1.1
+---
+version: 1
+algorithms:
+  - BlackLevel:
+  - Awb:
+  - Ccm:
+      ccms:
+        - ct: 2800
+          ccm: [ 1.910, -0.735, -0.176,
+                -0.303,  1.436, -0.133,
+                -0.150, -1.182,  2.332 ]
+        - ct: 4000
+          ccm: [ 1.415, -0.167, -0.248,
+                -0.364,  1.460, -0.095,
+                -0.101, -0.669,  1.770 ]
+        - ct: 5000
+          ccm: [ 1.365, -0.306, -0.059,
+                -0.270,  1.375, -0.105,
+                -0.040, -0.370,  1.410 ]
+        - ct: 6500
+          ccm: [ 1.258, -0.257, -0.002,
+                -0.245,  1.301, -0.055,
+                 0.021, -0.598,  1.577 ]
+  - Adjust:
+  - Agc:
+...
