[Unit]
Description=Configure and exercise Surface Pro 11 WSA speaker routing
# sound.target can precede the late-probing X1E80100 card, so the helper still
# polls for the card and topology controls.  Finish before a desktop session
# can let PipeWire open PCM1 with an incomplete FE-to-BE route.
After=sound.target alsa-restore.service alsa-state.service
Wants=sound.target
Before=display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/sp11-enable-wsa-routing.sh
RemainAfterExit=yes
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
